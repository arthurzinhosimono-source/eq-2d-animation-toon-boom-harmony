  <nodes>
    <!-- Master Composite -->
    <node type="COMPOSITE" name="Composite" x="0" y="500">
      <input name="In_BG"/>
      <input name="In_Characters"/>
      <input name="In_Props"/>
      <input name="In_FX"/>
    </node>

    <!-- Camera Node with Shaker FX for Earthquake -->
    <node type="CAMERA" name="Main_Camera" x="-200" y="0">
      <property name="position" val="0,0,0"/>
      <property name="zoom" val="1.0"/>
    </node>

    <!-- Background Layer Element Node -->
    <node type="READ" name="BG_Layer" x="-300" y="200">
      <property name="element" val="Backgrounds"/>
      <property name="drawing" val="BG_ApartmentRidge"/>
    </node>

    <!-- Character Nodes -->
    <node type="READ" name="Mommy_Maya" x="-100" y="200">
      <property name="element" val="Mommy_Maya"/>
      <property name="drawing" val="Maya_PurpleDress"/>
    </node>

    <node type="READ" name="Daddy_Roman" x="0" y="200">
      <property name="element" val="Daddy_Roman"/>
      <property name="drawing" val="Roman_PinkShirt"/>
    </node>

    <node type="READ" name="Baby_Jimmy" x="100" y="200">
      <property name="element" val="Baby_Jimmy"/>
      <property name="drawing" val="Jimmy_EQDiaper"/>
    </node>

    <!-- Special FX: Earthquake Shake -->
    <node type="CAMERA_SHAKE" name="FX_Earthquake" x="-200" y="300">
      <property name="intensity" val="5.0"/>
      <property name="enabled" val="false"/>
    </node>

    <!-- Teleport Effect Overlay -->
    <node type="READ" name="FX_Teleport_Glow" x="200" y="200">
      <property name="element" val="FX"/>
      <property name="drawing" val="Teleport_BlueLight"/>
    </node>
  </nodes>

